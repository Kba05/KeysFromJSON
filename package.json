{
  "name": "keys-from-json",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "description": "Turn JSON keys and structure into code, schemas, paths, and an interactive graph — entirely in the browser.",
  "keywords": [
    "json",
    "keys",
    "developer-tools",
    "typescript",
    "jsonpath",
    "react-flow"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --pool=threads --maxWorkers=1",
    "test:watch": "vitest --pool=threads --maxWorkers=1",
    "check:formats": "tsx scripts/check-formatters.ts",
    "check:build": "tsx scripts/check-build.ts",
    "check": "pnpm typecheck && pnpm test && pnpm check:formats"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "radix-ui": "^1.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/dagre": "^0.7.54",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
